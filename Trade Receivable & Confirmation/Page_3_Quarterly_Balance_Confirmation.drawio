<mxCell id="2" value="&lt;b&gt;SUB-PROCESS A: BALANCE CONFIRMATION CYCLE&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:normal;&#x27;&gt;Quarterly Reconciliation, Multi-Channel Dispatch, Dispute Escalation to Sales Head &amp; Audit MIS Preparation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;fontSize=15;fontStyle=1;align=center;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="40" y="30" width="1920" height="60" as="geometry" />
</mxCell>
<mxCell id="3" value="&lt;b&gt;Frequency:&lt;/b&gt; Every Quarter-End &amp;nbsp;|&amp;nbsp; &lt;b&gt;Preparation SLA:&lt;/b&gt; Within 15 Days of Quarter-End &amp;nbsp;|&amp;nbsp; &lt;b&gt;Collection SLA:&lt;/b&gt; Within 1 Month of Quarter-End &amp;nbsp;|&amp;nbsp; &lt;b&gt;Escalation Lead:&lt;/b&gt; Sales Head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#94a3b8;fontSize=11;align=center;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="40" y="95" width="1920" height="35" as="geometry" />
</mxCell>
<mxCell id="4" value="&lt;b&gt;Quarter-End Financial Close (Q1, Q2, Q3, Q4)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Periodic trigger: 31st Mar, 30th Jun, 30th Sep, 31st Dec&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e40af;fontSize=12;fontStyle=1;align=center;arcSize=20;" vertex="1" parent="1">
  <mxGeometry x="380" y="160" width="320" height="55" as="geometry" />
</mxCell>
<mxCell id="5" value="&lt;b&gt;Step 1: CC Executive Prepares Confirmations&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Extracts ledger balances and prepares balance confirmation&lt;br/&gt;letters per customer within &lt;b&gt;15 days&lt;/b&gt; of quarter-end&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="380" y="245" width="320" height="65" as="geometry" />
</mxCell>
<mxCell id="6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1" source="4" target="5" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="7" value="&lt;b&gt;Step 2-3: Head – CC &amp; Collection Review&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;CC Executive submits draft letters to Head CC;&lt;br/&gt;Head CC reviews, validates balances and authorizes dispatch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="380" y="340" width="320" height="65" as="geometry" />
</mxCell>
<mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1" source="5" target="7" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="9" value="&lt;b&gt;Step 4: Multi-Channel Dispatch &amp; Proof Collection&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;CC Team dispatches confirmation letters via:&lt;br/&gt;&lt;b&gt;Courier &amp;nbsp;|&amp;nbsp; Hand Delivery &amp;nbsp;|&amp;nbsp; Official Email&lt;/b&gt;&lt;br/&gt;Mandatory: Obtain courier POD or physical receipt ack&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="380" y="435" width="320" height="75" as="geometry" />
</mxCell>
<mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1" source="7" target="9" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="11" value="&lt;b&gt;Step 5: Coordinated Follow-Up&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;CC Team follows up with Customer AP &amp; Sales Executive;&lt;br/&gt;Target: Collect signed confirmations within 1 month&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="380" y="540" width="320" height="65" as="geometry" />
</mxCell>
