<mxCell id="33" value="&lt;b&gt;DETAILED NOTE 2: CREDIT TERMS, GRACE PERIOD &amp; DUNNING NOTICE 1&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Terms &amp; Grace:&lt;/b&gt; Standard trading credit is 30 days. A 5-day grace period is extended during which the Collection Executive makes direct contact with both the customer&#x27;s AP department and the internal Sales Executive.&lt;br/&gt;• &lt;b&gt;Triggering Notice 1:&lt;/b&gt; If payment is not received within the grace period (Day 7/8 post due date), &lt;b&gt;Reminder Notice 1&lt;/b&gt; is formally issued via official email/letter, granting a formal 7-day cure window.&lt;br/&gt;• &lt;b&gt;Remarks Tracking:&lt;/b&gt; Collection Executives must log specific customer responses and promised payment dates against the ledger in the weekly outstanding tracker.&lt;br/&gt;• &lt;b&gt;Hard Credit Rule:&lt;/b&gt; Total credit granted to any customer must NEVER exceed 120 days under any circumstances." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;fontColor=#1c1917;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1180" y="480" width="920" height="160" as="geometry" />
</mxCell>
<mxCell id="34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f59e0b;strokeWidth=1;dashed=1;endArrow=oval;endFill=1;startArrow=none;" edge="1" source="27" target="33" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="35" value="&lt;b&gt;Issue Reminder Notice 2&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Collection Exec issues Notice 2 (Overdue Day 15/16)&lt;br/&gt;Escalated warning; flags imminent ERP block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="480" y="880" width="300" height="60" as="geometry" />
</mxCell>
