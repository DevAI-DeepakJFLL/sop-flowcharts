</mxCell>
<mxCell id="13" value="&lt;b&gt;Sales Executive Direct Follow-up&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Sales Exec / BDM follows up for payment&lt;br/&gt;by &lt;b&gt;14th / 29th&lt;/b&gt; prior to due date&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
