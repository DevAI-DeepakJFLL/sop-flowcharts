  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="56" value="&lt;b&gt;DETAILED NOTE 4: DAY 60 ENFORCEMENT &amp; SECURITY DEPOSIT CHEQUE DEPOSIT&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Day 60 Benchmark (30+60 = 90 Days Total Ageing):&lt;/b&gt; When overdue reaches 60 days past due date (total 90 days from invoice issuance), the account enters high-risk recovery.&lt;br/&gt;• &lt;b&gt;Final Demand Email:&lt;/b&gt; Collection Executive dispatches the Final Reminder Email demanding immediate settlement.&lt;br/&gt;• &lt;b&gt;Security Deposit Cheque Presentation:&lt;/b&gt; The physical Security Deposit (SD) cheque (or Post-Dated Cheque / PDC collected during onboarding or credit extensions) is deposited into the company&#x27;s designated bank account to recover the outstanding balance.&lt;br/&gt;• &lt;b&gt;Clearance Monitoring:&lt;/b&gt; Bank clearing report is monitored daily by Credit Control to verify realization." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;fontColor=#1c1917;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1180" y="1260" width="920" height="160" as="geometry" />
</mxCell>
<mxCell id="57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f59e0b;strokeWidth=1;dashed=1;endArrow=oval;endFill=1;startArrow=none;" edge="1" source="50" target="56" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="58" value="&lt;b&gt;PHASE 4: CHEQUE DISHONOR &amp; CRIMINAL PROCEEDINGS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Immediate Customer Intimation&lt;br/&gt;• Cheque Return Memo from Bank&lt;br/&gt;• Statutory 7-Day Demand Notice&lt;br/&gt;• Mandatory 7-Day Waiting Period&lt;br/&gt;• Filing Criminal Case (Sec 138 NI Act)&lt;br/&gt;• 90-Day Legal Settlement Window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="40" y="1490" width="380" height="520" as="geometry" />
</mxCell>
<mxCell id="59" value="&lt;b&gt;Cheque Dishonor Intimation &amp; Final Notice&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;• Immediate intimation of bounce to customer&lt;br/&gt;• Formal &lt;b&gt;Cheque Bounce Notice&lt;/b&gt; issued (within 7 days)&lt;br/&gt;• &lt;b&gt;Strict 7-Day Statutory Cure Period&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#991b1b;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="480" y="1475" width="300" height="75" as="geometry" />
</mxCell>
<mxCell id="60" value="Yes (Bounced)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#dc2626;fontSize=11;fontStyle=1;" edge="1" source="52" target="59" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="61" value="&lt;b&gt;Settled within&lt;br/&gt;7-Day Cure Window?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
