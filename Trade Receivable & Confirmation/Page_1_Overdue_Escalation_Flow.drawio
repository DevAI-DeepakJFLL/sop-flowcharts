<mxCell id="41" value="&lt;b&gt;PHASE 3: 30-DAY CRITICAL CUTOFF &amp; ERP CODE BLOCK&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Automatic System Block in ERP&lt;br/&gt;• Complete Booking Embargo&lt;br/&gt;• Reminder Notice 3 (Final Notice)&lt;br/&gt;• Day 60 Final Notice Warning&lt;br/&gt;• Physical Security Deposit Invocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="40" y="1070" width="380" height="350" as="geometry" />
</mxCell>
<mxCell id="42" value="&lt;b&gt;AUTO-BLOCK CLIENT CODE IN ERP&lt;br/&gt;&amp; Issue Final Reminder Notice 3&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;• &lt;b&gt;ERP Auto-Lock:&lt;/b&gt; System blocks new job bookings&lt;br/&gt;• &lt;b&gt;Notice 3 Issued:&lt;/b&gt; Formal notice of commercial freeze&lt;br/&gt;• Triggered at &lt;b&gt;Day 30/31&lt;/b&gt; post due date&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#991b1b;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="480" y="1070" width="300" height="75" as="geometry" />
</mxCell>
<mxCell id="43" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#dc2626;fontSize=11;fontStyle=1;" edge="1" source="37" target="42" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="44" value="&lt;b&gt;DETAILED NOTE 3: NOTICE 2, ERP AUTO-BLOCK &amp; SHIPMENT EMBARGO MANDATE&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Notice 2 Escalation (Day 15/16):&lt;/b&gt; Warns debtor of imminent system-level commercial sanctions and credit suspension.&lt;br/&gt;• &lt;b&gt;ERP Auto-Block Mechanism (Day 30/31):&lt;/b&gt; Once overdue crosses 30 days, the ERP system automatically halts all job bookings and shipping operations for the customer code. No sales coordinator or billing clerk can create new shipments.&lt;br/&gt;• &lt;b&gt;Notice 3 (Final Notice):&lt;/b&gt; Serves formal legal notice of shipment suspension and warns of security deposit cheque presentation and legal litigation if dues remain unpaid.&lt;br/&gt;• &lt;b&gt;Exception Authority:&lt;/b&gt; Skipping any reminder notice or lifting an ERP block requires explicit written approval from &lt;b&gt;Head – CC &amp; Collection&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;fontColor=#1c1917;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1180" y="950" width="920" height="180" as="geometry" />
</mxCell>
<mxCell id="45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f59e0b;strokeWidth=1;dashed=1;endArrow=oval;endFill=1;startArrow=none;" edge="1" source="42" target="44" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
