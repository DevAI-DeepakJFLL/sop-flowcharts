<mxCell id="63" value="&lt;b&gt;Payment Realized&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Receipt issued; Cheque returned; Closed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="1">
  <mxGeometry x="860" y="1590" width="240" height="50" as="geometry" />
</mxCell>
<mxCell id="64" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontSize=11;fontStyle=1;" edge="1" source="61" target="63" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="65" value="&lt;b&gt;Wait Additional Statutory Period&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Wait &lt;b&gt;7 additional days&lt;/b&gt; beyond completion of period&lt;br/&gt;(Total 14/16 days post-bounce before filing)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#9a3412;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="480" y="1680" width="300" height="60" as="geometry" />
</mxCell>
<mxCell id="66" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#dc2626;fontSize=11;fontStyle=1;" edge="1" source="61" target="65" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="67" value="&lt;b&gt;File Criminal Case Against Customer&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Collection Exec &amp; Legal Counsel file criminal complaint&lt;br/&gt;under &lt;b&gt;Section 138 of Negotiable Instruments Act&lt;/b&gt;&lt;br/&gt;for dishonor of cheque&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#a855f7;fontColor=#6b21a8;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="480" y="1765" width="300" height="75" as="geometry" />
</mxCell>
