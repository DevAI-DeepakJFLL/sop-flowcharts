  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="71" value="&lt;b&gt;Court / Mutual Settlement Realized&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Funds received; Criminal complaint withdrawn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="1">
  <mxGeometry x="860" y="1880" width="240" height="50" as="geometry" />
</mxCell>
<mxCell id="72" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontSize=11;fontStyle=1;" edge="1" source="69" target="71" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="73" value="&lt;b&gt;DETAILED NOTE 5: STATUTORY CHEQUE BOUNCE PROTOCOL &amp; SECTION 138 NI ACT LITIGATION&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Bank Return Memo:&lt;/b&gt; Upon receiving the cheque dishonor advice/memo from the bank (e.g. &#x27;Funds Insufficient&#x27;, &#x27;Account Closed&#x27;, &#x27;Stop Payment&#x27;), the customer is immediately intimated in writing.&lt;br/&gt;• &lt;b&gt;Statutory Cure Notice:&lt;/b&gt; A formal legal demand notice under Section 138 of the Negotiable Instruments Act is served within 7 days, demanding payment within a strict 7-day cure window.&lt;br/&gt;• &lt;b&gt;Mandatory Waiting Period:&lt;/b&gt; Following expiration of the 7-day cure notice, the company waits an additional 7 days (or total 16 days post-bounce as specified in Section 4B written table) to establish failure to comply.&lt;br/&gt;• &lt;b&gt;Criminal Case Lodgement:&lt;/b&gt; Collection Executive coordinates with Company Legal Counsel to lodge a criminal complaint before the Judicial Magistrate against the drawer of the dishonored cheque.&lt;br/&gt;• &lt;b&gt;Settlement Window:&lt;/b&gt; A 90-day tracking window is maintained to facilitate court-monitored settlement or compounding of offenses." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;fontColor=#1c1917;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1180" y="1580" width="920" height="220" as="geometry" />
</mxCell>
<mxCell id="74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f59e0b;strokeWidth=1;dashed=1;endArrow=oval;endFill=1;startArrow=none;" edge="1" source="67" target="73" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="75" value="&lt;b&gt;PHASE 5: 150-DAY CUMULATIVE DELINQUENCY &amp; SBI INSURANCE&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Longstop Loss Threshold (150 Days)&lt;br/&gt;• Commercial Recovery Exhausted&lt;br/&gt;• Credit Insurance Claim Lodgement&lt;br/&gt;• SBI General Insurance Claim Docket&lt;br/&gt;• Payout &amp; Bad-Debt Accounting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="40" y="2040" width="380" height="260" as="geometry" />
</mxCell>
<mxCell id="76" value="&lt;b&gt;Total Overdue Reaches 150 Days:&lt;br/&gt;File Claim with Insurance Company (SBI)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Submit formal credit insurance claim dossier with&lt;br/&gt;SBI General Insurance for default recovery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#4c1d95;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="480" y="1970" width="300" height="75" as="geometry" />
</mxCell>
<mxCell id="77" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#dc2626;fontSize=11;fontStyle=1;" edge="1" source="69" target="76" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="78" value="&lt;b&gt;Insurance Claim Assessment &amp; Payout&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;SBI assesses claim, reviews court filing &amp; evidence;&lt;br/&gt;Insurance indemnity payout processed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;fontColor=#4c1d95;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="480" y="2075" width="300" height="65" as="geometry" />
</mxCell>
<mxCell id="79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1" source="76" target="78" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="80" value="&lt;b&gt;Ledger Realization &amp; Write-off Recovery&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Account adjusted in ERP; salvage rights assigned;&lt;br/&gt;Debtor recovery cycle concluded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="1">
  <mxGeometry x="480" y="2170" width="300" height="60" as="geometry" />
</mxCell>
<mxCell id="81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=11;" edge="1" source="78" target="80" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="82" value="&lt;b&gt;DETAILED NOTE 6: 150-DAY SBI CREDIT INSURANCE CLAIM LODGEMENT POLICY&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Eligibility Benchmark:&lt;/b&gt; The SOP establishes a hard long-stop threshold: unresolved overdue trade receivables reaching &lt;b&gt;150 days cumulative overdue&lt;/b&gt; are transferred to credit insurance recovery.&lt;br/&gt;• &lt;b&gt;Documentation Docket Required:&lt;/b&gt; The Collection Executive compiles the comprehensive SBI Insurance dossier: original invoices, airway bills / bills of lading, proof of delivery (POD), dispatched SOA copies, Reminder Notices 1, 2, 3, bank dishonor memo, Section 138 notice, and court filing acknowledgment.&lt;br/&gt;• &lt;b&gt;Indemnification &amp; Recovery:&lt;/b&gt; Upon insurer claim approval and disbursement, accounts receivable is adjusted, subrogation rights are executed with SBI, and bad-debt accounting entries are passed in ERP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;fontColor=#1c1917;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1180" y="1940" width="920" height="180" as="geometry" />
</mxCell>
<mxCell id="83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f59e0b;strokeWidth=1;dashed=1;endArrow=oval;endFill=1;startArrow=none;" edge="1" source="76" target="82" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="84" value="&lt;b&gt;DETAILED NOTE 7: INTERNAL SOP DISCREPANCIES &amp; AUDIT RECOMMENDATIONS (SECTION 8)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Discrepancy 1 (Dunning Timelines):&lt;/b&gt; Flowchart Section 5 indicates notice triggers at Days 7, 15, 30, and 60. However, Section 4B written table states Notice 1 at Day 8, Notice 2 at Day 16, Notice 3 at Day 31, and Legal Case at 16 days after cheque bounce. &lt;i&gt;Recommendation:&lt;/i&gt; Standardize all automated ERP rules to Day 8/16/31 or 7/15/30 definitively.&lt;br/&gt;• &lt;b&gt;Discrepancy 2 (150-Day Clock Alignment):&lt;/b&gt; Flowchart checks 90 days after criminal filing, while Section 4B specifies &#x27;after completion of 150 days total&#x27;. While both align closely, the cumulative 150-day calendar clock should be the master control.&lt;br/&gt;• &lt;b&gt;Discrepancy 3 (Governance Sign-off):&lt;/b&gt; The SOP Version Control table had blank &#x27;Approved By&#x27; signatures despite being signed by Manager Siddhesh Hule. &lt;i&gt;Recommendation:&lt;/i&gt; Ensure final MD/Director sign-off is formally counter-signed on file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#881337;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1180" y="2150" width="920" height="170" as="geometry" />
</mxCell>
  </root>
</mxGraphModel>