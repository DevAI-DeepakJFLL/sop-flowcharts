  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="69" value="&lt;b&gt;Settled / Paid within&lt;br/&gt;90 Days Post-Filing?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
