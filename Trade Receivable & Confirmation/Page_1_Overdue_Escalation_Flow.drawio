</mxCell>
<mxCell id="16" value="&lt;b&gt;DETAILED NOTE 1: STATEMENT DISPATCH &amp; PRE-DUE SALES FOLLOW-UP&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Dispatch Schedule:&lt;/b&gt; Statements of Accounts (SOA) are generated and emailed by the Billing (CC) Executive on fixed cycles: the &lt;b&gt;7th&lt;/b&gt; of each month (covering bills due on the 15th) and the &lt;b&gt;22nd&lt;/b&gt; of each month (covering bills due on the 30th).&lt;br/&gt;• &lt;b&gt;Commercial Alignment:&lt;/b&gt; Sales Executives / BDMs are directly responsible for client relationship management and must proactively follow up by the &lt;b&gt;14th&lt;/b&gt; and &lt;b&gt;29th&lt;/b&gt; to preempt payment delays.&lt;br/&gt;• &lt;b&gt;Objective:&lt;/b&gt; Ensure invoices are certified, disputed charges are resolved early, and payment runs are scheduled within agreed payment terms without administrative friction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#f59e0b;fontColor=#1c1917;fontSize=11;fontStyle=0;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="1180" y="220" width="920" height="140" as="geometry" />
</mxCell>
<mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f59e0b;strokeWidth=1;dashed=1;endArrow=oval;endFill=1;startArrow=none;" edge="1" source="12" target="16" parent="1">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="18" value="&lt;b&gt;PHASE 2: DUE DATE, GRACE PERIOD &amp; EARLY DUNNING&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Invoice Due Date Reached&lt;br/&gt;• 5-Day Standard Grace Period&lt;br/&gt;• Collection Executive Interventions&lt;br/&gt;• Reminder Notice 1 (7-Day Window)&lt;br/&gt;• Reminder Notice 2 Escalation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
