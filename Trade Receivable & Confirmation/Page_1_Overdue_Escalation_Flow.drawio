<mxCell id="12" value="&lt;b&gt;Dispatch Statement of Accounts (SOA)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;Billing Exec emails SOA on &lt;b&gt;7th &amp; 22nd&lt;/b&gt; of month&lt;br/&gt;(Due dates: 15th &amp; 30th respectively)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;fontStyle=0;align=center;arcSize=8;" vertex="1" parent="1">
