  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="50" value="&lt;b&gt;Send Final Reminder Email (Day 60)&lt;br/&gt;&amp; Deposit Security Deposit (SD) Cheque&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;• Final email sent at Day 60 overdue (90 days total)&lt;br/&gt;• Physical SD Cheque presented to bank for clearance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#991b1b;fontSize=12;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
  <mxGeometry x="480" y="1275" width="300" height="70" as="geometry" />
</mxCell>
